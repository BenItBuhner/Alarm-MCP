{
  "name": "alarm-mcp",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "overrides": {
      "body-parser@2.3.0": "2.4.0",
      "fast-uri@3.1.8": "3.1.9",
      "http-cache-semantics@4.2.0": "4.3.0",
      "tinypool@<2.1.2": "2.1.2",
      "undici@7.29.1": "7.30.1"
    }
  },
  "scripts": {
    "dev:backend": "pnpm --filter @alarm-mcp/backend dev",
    "dev:web": "pnpm --filter @alarm-mcp/web dev",
    "dev:desktop": "pnpm --filter @alarm-mcp/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "android:test": "cd apps/android && ./gradlew :app:testDebugUnitTest :app:lintDebug",
    "android:build": "cd apps/android && ./gradlew :app:assembleDebug"
  }
}
