{
  "name": "@alarm-mcp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./shared": "./convex/lib/shared.ts"
  },
  "scripts": {
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.104"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.15.0",
    "convex-test": "^0.0.38",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
