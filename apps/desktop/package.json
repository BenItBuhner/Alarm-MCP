{
  "name": "@alarm-mcp/desktop",
  "productName": "Alarm MCP",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop alarm client for Alarm MCP — lets your AI agents wake you up.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node build.mjs && electron-builder --dir",
    "dist": "node build.mjs && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@alarm-mcp/backend": "workspace:*",
    "@types/node": "^22.15.0",
    "convex": "^1.46.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.alarmmcp.desktop",
    "productName": "Alarm MCP",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
